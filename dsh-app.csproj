<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>dsh_app</RootNamespace>
    <AssemblyName>dsh-app</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.7.2</Version>
    <!-- 免 InformationalVersion 的 +sha 后缀（应用自更新版本号解析用） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 更新器脚本模板：入库（scripts/apply-update.ps1，可读可测）+ 嵌入程序集（AppUpdater 运行时提取写盘） -->
  <ItemGroup>
    <EmbeddedResource Include="scripts\apply-update.ps1" LogicalName="dsh_app.Scripts.apply-update.ps1" />
    <!-- dsh-notify 插件包（会话完成通知 v2）：NotifyPluginInstaller 首启幂等写入 profile，四要件挂载 -->
    <EmbeddedResource Include="scripts\dsh-notify\index.js" LogicalName="dsh_app.Scripts.dsh-notify.index.js" />
    <EmbeddedResource Include="scripts\dsh-notify\package.json" LogicalName="dsh_app.Scripts.dsh-notify.package.json" />
    <EmbeddedResource Include="scripts\dsh-notify\cordis.patch.yml" LogicalName="dsh_app.Scripts.dsh-notify.cordis.patch.yml" />
    <!-- 关于窗口品牌图标（WPF 资源，pack URI /Assets/icon256.png 引用） -->
    <Resource Include="Assets\icon256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- LAN 共享代理：Kestrel 迷你宿主 + YARP 反向代理（self-contained 发布时一并打包进单 exe） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>

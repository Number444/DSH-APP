<Window x:Class="dsh_app.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:dsh_app.Helpers"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgWindowBrush}">
    <StackPanel Margin="24,22,24,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GlyphText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
        <!-- 长文本（如更新 changelog）超 320px 出现滚动条；短消息不受影响（§6.2 统一 CustomScrollBar） -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="MessageScroller"
                          MaxHeight="320"
                          VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
            <helpers:CustomScrollBar Grid.Column="1"
                                     Width="16"
                                     TargetScrollViewer="{Binding ElementName=MessageScroller}" />
        </Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Padding="20,8"
                    IsCancel="True"
                    Style="{DynamicResource RoundedButton}"
                    Background="{DynamicResource BgCardBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Click="CancelButton_Click" />
            <Button x:Name="OkButton"
                    Content="确定"
                    Margin="12,0,0,0"
                    Padding="20,8"
                    IsDefault="True"
                    Style="{DynamicResource RoundedButton}"
                    Background="{DynamicResource ButtonBlueBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>

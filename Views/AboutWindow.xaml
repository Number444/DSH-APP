<Window x:Class="dsh_app.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="◈"
                       FontSize="30"
                       Foreground="{DynamicResource AccentBlueBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0">
                <TextBlock Text="DeepSeek Harness 桌面壳"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="dsh-app v1.2.0"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="DeepSeek Harness Web GUI 的桌面封装（WPF + WebView2 纯壳，零侵入）。"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
</Window>

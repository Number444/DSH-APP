<Window x:Class="dsh_app.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgWindowBrush}">
    <Border Margin="1"
            Padding="20,16"
            Background="{DynamicResource BgWindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ProgressBar Margin="0,12,0,0"
                         Height="3"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource AccentBlueBrush}"
                         Background="{DynamicResource TrackBgBrush}" />
            <TextBlock x:Name="DetailText"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</Window>

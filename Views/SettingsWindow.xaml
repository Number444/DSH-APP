<Window x:Class="dsh_app.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,24">
        <TextBlock Text="主题模式"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Border Height="32"
                Margin="0,10,0,0"
                Padding="3"
                HorizontalAlignment="Left"
                Background="{DynamicResource TrackBgBrush}"
                CornerRadius="16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RadioDark"
                             Content="深色"
                             GroupName="Theme"
                             Style="{DynamicResource CapsuleSegmentStyle}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="RadioLight"
                             Content="浅色"
                             GroupName="Theme"
                             Style="{DynamicResource CapsuleSegmentStyle}"
                             Checked="OnThemeChanged" />
            </StackPanel>
        </Border>

        <TextBlock Text="跟随系统"
                   Margin="0,18,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <CheckBox x:Name="ChkSystem"
                  Content="根据系统浅色 / 深色模式自动切换"
                  Margin="0,10,0,0"
                  Style="{DynamicResource ToggleSwitchStyle}"
                  Checked="OnThemeChanged"
                  Unchecked="OnThemeChanged" />
        <TextBlock Text="开启后自动跟随系统，忽略上面的选择。"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextWeakBrush}" />

        <!-- ==================== 更新 ==================== -->
        <TextBlock Text="更新"
                   Margin="0,16,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <CheckBox x:Name="ChkAutoCheckUpdate"
                  Content="启动时自动检查 Harness 更新"
                  Margin="0,10,0,0"
                  Style="{DynamicResource ToggleSwitchStyle}"
                  Checked="OnAutoCheckUpdateChanged"
                  Unchecked="OnAutoCheckUpdateChanged" />
        <TextBlock Text="后台静默检查，发现新版本时在顶栏菜单提示。"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextWeakBrush}" />

        <!-- ==================== 常驻 ==================== -->
        <TextBlock Text="常驻"
                   Margin="0,16,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <CheckBox x:Name="ChkTrayClose"
                  Content="关闭窗口时最小化到托盘（服务继续运行）"
                  Margin="0,10,0,0"
                  Style="{DynamicResource ToggleSwitchStyle}"
                  Checked="OnTrayCloseChanged"
                  Unchecked="OnTrayCloseChanged" />
        <TextBlock Text="隐藏到系统托盘，双击图标恢复窗口，右键菜单可退出；关闭此项则关窗即停服退出。"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextWeakBrush}"
                   TextWrapping="Wrap" />

        <!-- ==================== 余额显示 ==================== -->
        <TextBlock Text="余额显示"
                   Margin="0,16,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <CheckBox x:Name="ChkShowBalance"
                  Content="在顶栏显示 DeepSeek 余额"
                  Margin="0,10,0,0"
                  Style="{DynamicResource ToggleSwitchStyle}"
                  Checked="OnShowBalanceChanged"
                  Unchecked="OnShowBalanceChanged" />

        <StackPanel x:Name="BalanceOptions"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="AuthStatusText"
                       FontSize="11"
                       Foreground="{DynamicResource TextWeakBrush}"
                       TextWrapping="Wrap" />
            <Button x:Name="BtnAuthAction"
                    Margin="0,8,0,0"
                    Padding="14,6"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Style="{DynamicResource RoundedButton}"
                    Background="{DynamicResource BgCardBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Click="BtnAuthAction_Click"
                    Visibility="Collapsed" />
            <StackPanel x:Name="ManualKeyPanel"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="API Key（自动读取不可用时）"
                           FontSize="11"
                           Foreground="{DynamicResource TextWeakBrush}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <PasswordBox x:Name="ApiKeyBox"
                                 Width="240"
                                 Height="28"
                                 FontSize="12"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 LostFocus="ApiKeyBox_LostFocus" />
                    <Button Content="获取 Key"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            FontSize="12"
                            Style="{DynamicResource RoundedButton}"
                            Background="{DynamicResource BgCardBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Click="ApiKeyLink_Click" />
                </StackPanel>
                <TextBlock x:Name="ApiKeyHint"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextWeakBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 余额告警（仅余额显示开启时可见） -->
            <CheckBox x:Name="ChkBalanceAlert"
                      Content="余额低于阈值时提醒"
                      Margin="0,14,0,0"
                      Style="{DynamicResource ToggleSwitchStyle}"
                      Checked="OnBalanceAlertChanged"
                      Unchecked="OnBalanceAlertChanged" />
            <StackPanel x:Name="AlertThresholdPanel"
                        Orientation="Horizontal"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="阈值（元）"
                           FontSize="11"
                           Foreground="{DynamicResource TextWeakBrush}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="ThresholdBox"
                         Width="70"
                         Height="26"
                         Margin="8,0,0,0"
                         FontSize="12"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         LostFocus="ThresholdBox_LostFocus" />
            </StackPanel>
            <TextBlock Text="余额跌破阈值时弹出系统通知，点击通知直达充值页。"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextWeakBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</Window>

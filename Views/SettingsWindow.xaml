<Window x:Class="dsh_app.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,24">
        <TextBlock Text="主题模式"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,10,0,0">
            <RadioButton x:Name="RadioDark"
                         Content="深色"
                         GroupName="Theme"
                         FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"
                         Checked="OnThemeChanged" />
            <RadioButton x:Name="RadioLight"
                         Content="浅色"
                         GroupName="Theme"
                         Margin="24,0,0,0"
                         FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"
                         Checked="OnThemeChanged" />
        </StackPanel>

        <TextBlock Text="跟随系统"
                   Margin="0,18,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <CheckBox x:Name="ChkSystem"
                  Content="根据系统浅色 / 深色模式自动切换（开启后忽略上面的选择）"
                  Margin="0,10,0,0"
                  FontSize="13"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  VerticalContentAlignment="Center"
                  Checked="OnThemeChanged"
                  Unchecked="OnThemeChanged" />
        <TextBlock Text="未开启时始终使用上面的主题模式。"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextWeakBrush}" />
    </StackPanel>
</Window>

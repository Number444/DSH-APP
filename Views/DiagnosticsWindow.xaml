<Window x:Class="dsh_app.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="诊断信息"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,24">
        <TextBlock Text="诊断信息"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="环境与运行状态，用于问题排查；复制后可直接发给 AI。"
                   Margin="0,4,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- 键值行列表（固定行高防逐行填充抖动；状态点绿/黄/红/蓝走双套资源，R8） -->
        <Border Margin="0,14,0,0"
                Padding="16,12"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ItemsControl x:Name="RowList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{Binding DotBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Key}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextWeakBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Value}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 底部操作行 -->
        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="CopyStatusText"
                       FontSize="11"
                       Foreground="{DynamicResource TextWeakBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CopyButton"
                        Content="复制全部"
                        Padding="14,6"
                        FontSize="12"
                        Style="{DynamicResource RoundedButton}"
                        Background="{DynamicResource BgCardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Click="CopyButton_Click" />
                <Button x:Name="RefreshButton"
                        Content="刷新"
                        Margin="10,0,0,0"
                        Padding="14,6"
                        FontSize="12"
                        Style="{DynamicResource RoundedButton}"
                        Background="{DynamicResource BgCardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Click="RefreshButton_Click" />
                <Button Content="打开日志"
                        Margin="10,0,0,0"
                        Padding="14,6"
                        FontSize="12"
                        Style="{DynamicResource RoundedButton}"
                        Background="{DynamicResource BgCardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Click="LogButton_Click" />
                <Button Content="关闭"
                        Margin="10,0,0,0"
                        Padding="14,6"
                        FontSize="12"
                        Style="{DynamicResource RoundedButton}"
                        Background="{DynamicResource BgCardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>

<Window x:Class="dsh_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helpers="clr-namespace:dsh_app.Helpers"
        xmlns:views="clr-namespace:dsh_app.Views"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="DeepSeek Harness"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        Icon="{x:Null}"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏（WindowChrome 自绘标题栏） ==================== -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource BgWindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="DeepSeek Harness"
                       Margin="16,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- 工具按钮 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0">
                <Button x:Name="TitleBtnRefresh"
                        Content="刷新"
                        Style="{DynamicResource IconButton}"
                        Click="TitleBtnRefresh_Click" />
                <Button x:Name="TitleBtnBrowser"
                        Content="浏览器"
                        Style="{DynamicResource IconButton}"
                        Click="TitleBtnBrowser_Click" />
                <Button x:Name="TitleBtnRestart"
                        Content="重启服务"
                        Style="{DynamicResource IconButton}"
                        Click="TitleBtnRestart_Click" />
                <Button x:Name="TitleBtnMenu"
                        Content="菜单"
                        Style="{DynamicResource IconButton}"
                        Click="TitleBtnMenu_Click" />
                <!-- 余额显示（菜单右侧，非工具按钮；左键弹菜单（刷新/充值）；仅在设置开启时可见）：
                     IconButton 样式提供 hover 点击反馈（背景 HoverBgBrush），
                     与顶栏工具按钮同高 26 同中心，严格一条线 -->
                <Button x:Name="TitleBalance"
                        Height="26"
                        Margin="8,0,4,0"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{DynamicResource IconButton}"
                        Foreground="{DynamicResource TextWeakBrush}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseLeftButtonDown="TitleBalance_PreviewMouseDown"
                        PreviewMouseLeftButtonUp="TitleBalance_PreviewMouseUp"
                        Click="TitleBalance_Click"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TitleBalanceText"
                               MaxWidth="80"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>

            <!-- 余额刷新状态卡（锚定余额按钮下方；Popup 独立 HWND，不受 airspace 影响） -->
            <Popup x:Name="BalanceStatusPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TitleBalance}"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="False">
                <Border Padding="12,8"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="BalanceStatusText"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Popup>

            <!-- 菜单下拉（Popup 独立 HWND，不受 WebView2 airspace 影响；内容为公共菜单控件）。
                 StaysOpen=True：所有外部点击统一走全局钩子关闭（动画收拢）；若用 StaysOpen=False，
                 点击 WPF 区域会触发 Popup 内部自动关闭，绕过动画直接瞬关（v1.3.1 实测）。
                 安全区留白（AppMenuPanel.AnimSafePad=40）让出动画空间，故定位需反向补偿 offset。 -->
            <Popup x:Name="MenuPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TitleBtnMenu}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   HorizontalOffset="-40"
                   VerticalOffset="-40">
                <views:AppMenuPanel x:Name="TopMenu" />
            </Popup>

            <!-- 余额左键菜单：刷新余额 / 打开充值页（右键交互已删除；关闭统一走钩子/显式，动画收拢） -->
            <Popup x:Name="BalanceMenuPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TitleBalance}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   HorizontalOffset="-40"
                   VerticalOffset="-40">
                <views:AppMenuPanel x:Name="BalanceMenu" />
            </Popup>

            <!-- 托盘右键菜单：Popup + 公共菜单控件，与 APP 内菜单完全同源（弃用 ContextMenu） -->
            <Popup x:Name="TrayMenuPopup"
                   Placement="AbsolutePoint"
                   AllowsTransparency="True"
                   StaysOpen="True">
                <views:AppMenuPanel x:Name="TrayMenu" />
            </Popup>

            <!-- 系统按钮 -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal">
                <Button x:Name="TitleBtnMin"
                        Content="─"
                        ToolTip="最小化"
                        Style="{DynamicResource SysButton}"
                        Click="TitleBtnMin_Click" />
                <Button x:Name="TitleBtnMax"
                        Content="□"
                        ToolTip="最大化"
                        Style="{DynamicResource SysButton}"
                        Click="TitleBtnMax_Click" />
                <Button x:Name="TitleBtnClose"
                        Content="✕"
                        ToolTip="关闭"
                        Style="{DynamicResource SysButtonClose}"
                        Click="TitleBtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- ==================== 内容区 ====================
             四周留出 WindowChrome 的 resize 热区（普通状态 5px）；
             WebView2 的 HWND 会拦截热区命中测试，必须让出边缘才能拖拽调窗。 -->
        <Grid x:Name="ContentRoot"
              Grid.Row="1"
              Margin="5,0,5,5">
            <!-- Harness Web UI（初始隐藏：避免 HWND 子窗口盖住启动覆盖层，页面加载完成后再显示） -->
            <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

            <!-- 状态 / 错误覆盖层：
                 中央 = 品牌区（正常）或错误区（失败，替换品牌）
                 左下 = 启动进度卡片（低调，不喧宾夺主） -->
            <Grid x:Name="Overlay"
                  Panel.ZIndex="10"
                  Background="{DynamicResource OverlayBgBrush}"
                  Visibility="Collapsed">

                <!-- 中央品牌区 -->
                <StackPanel x:Name="CenterBrand"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="DeepSeek Harness"
                               FontSize="40"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CenterSubtitle"
                               Margin="0,12,0,0"
                               Text="正在启动…"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 中央错误区（失败时替换品牌区） -->
                <StackPanel x:Name="CenterError"
                            MaxWidth="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="OverlayGlyph"
                                   Text="⚠"
                                   FontSize="20"
                                   Foreground="{DynamicResource AccentOrangeBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayTitle"
                                   Margin="12,0,0,0"
                                   Text="启动失败"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="OverlayErrorDetail"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" />
                    <StackPanel x:Name="OverlayActions"
                                Orientation="Horizontal"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="RetryButton"
                                Content="重试"
                                Padding="24,9"
                                Click="RetryButton_Click"
                                Style="{DynamicResource RoundedButton}"
                                Background="{DynamicResource ButtonGreenBrush}"
                                Foreground="White"
                                BorderThickness="0" />
                        <Button x:Name="LogButton"
                                Content="打开日志"
                                Margin="12,0,0,0"
                                Padding="24,9"
                                Click="LogButton_Click"
                                Style="{DynamicResource RoundedButton}"
                                Background="{DynamicResource BgCardBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" />
                        <!-- 仅 Runtime 缺失错误卡可见：引导用户下载官方安装包 -->
                        <Button x:Name="RuntimeButton"
                                Content="下载 WebView2 Runtime"
                                Margin="12,0,0,0"
                                Padding="24,9"
                                Click="RuntimeButton_Click"
                                Style="{DynamicResource RoundedButton}"
                                Background="{DynamicResource BgCardBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- 左下角启动进度卡片（半透明，不喧宾夺主） -->
                <Border Width="400"
                        Margin="20,0,0,20"
                        Padding="20,16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource CardTranslucentBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="启动进度"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="13"
                                                   Foreground="{Binding IconBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="10,0,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   Margin="12,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressBar x:Name="OverlayProgress"
                                     Margin="0,10,0,0"
                                     Height="3"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBlueBrush}"
                                     Background="{DynamicResource TrackBgBrush}" />

                        <!-- 应用更新下载取消按钮（仅下载阶段可见） -->
                        <Button x:Name="CancelDownloadButton"
                                Content="取消下载"
                                Margin="0,10,0,0"
                                Padding="14,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Style="{DynamicResource RoundedButton}"
                                Background="{DynamicResource BgCardBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Click="CancelDownloadButton_Click"
                                Visibility="Collapsed" />

                        <!-- 实时日志（Toolbox 风格自定义滚动条） -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="OverlayLogScroller"
                                          MaxHeight="88"
                                          VerticalScrollBarVisibility="Hidden">
                                <TextBlock x:Name="OverlayDetail"
                                           TextWrapping="Wrap"
                                           LineHeight="16"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </ScrollViewer>
                            <helpers:CustomScrollBar Grid.Column="1"
                                                     Width="16"
                                                     TargetScrollViewer="{Binding ElementName=OverlayLogScroller}" />
                        </Grid>

                        <TextBlock x:Name="VersionFooter"
                                   Text="dsh-app · DeepSeek Harness 桌面壳"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextWeakBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 系统托盘图标（Hardcodet WPF 实现；最小化到托盘时窗口隐藏但服务继续）。
             Icon 与事件在代码中绑定；右键菜单经 TrayRightMouseDown → TrayMenuPopup（同源公共菜单）。 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="DeepSeek Harness"
                        Visibility="Collapsed" />
    </Grid>
</Window>

<Window x:Class="dsh_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DeepSeek Harness"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>

        <!-- Harness Web UI -->
        <wv2:WebView2 x:Name="WebView" />

        <!-- 状态 / 错误覆盖层 -->
        <Grid x:Name="Overlay"
              Panel.ZIndex="10"
              Background="#E60D1117"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxWidth="560"
                    Padding="32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OverlayGlyph"
                                   Text="◈"
                                   FontSize="20"
                                   Foreground="#58A6FF"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayTitle"
                                   Margin="12,0,0,0"
                                   Text="正在启动 DeepSeek Harness…"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#E6EDF3"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="OverlayDetail"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               FontSize="13"
                               Foreground="#9DA7B3" />

                    <ProgressBar x:Name="OverlayProgress"
                                 Margin="0,18,0,0"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Foreground="#58A6FF"
                                 Background="#21262D" />

                    <StackPanel x:Name="OverlayActions"
                                Orientation="Horizontal"
                                Margin="0,20,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="RetryButton"
                                Content="重试"
                                Padding="24,9"
                                Click="RetryButton_Click"
                                Style="{StaticResource RoundedButton}"
                                Background="#238636"
                                Foreground="White"
                                BorderThickness="0" />
                        <Button x:Name="LogButton"
                                Content="打开日志"
                                Margin="12,0,0,0"
                                Padding="24,9"
                                Click="LogButton_Click"
                                Style="{StaticResource RoundedButton}"
                                Background="#21262D"
                                Foreground="#E6EDF3"
                                BorderBrush="#30363D"
                                BorderThickness="1" />
                    </StackPanel>

                    <TextBlock x:Name="OverlayVersion"
                               Margin="0,24,0,0"
                               Text="dsh-app v1.0 · DeepSeek Harness 桌面壳"
                               FontSize="11"
                               Foreground="#6E7681" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
